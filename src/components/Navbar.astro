---
import IconSVG from "./IconSVG.astro";
import "../styles/navbar.css";
import IconColorSVG from "./IconColorSVG.astro";

const links = [
  // { href: "#projects", text: "Projects" },
  // { href: "#experience", text: "Experience" },
  { href: "/JIMGENG_Resume_202610.pdf", text: "Resume" },
];
---

<nav class="navbar">
  <div class="logo"><a href="/">
    <div class="icon-white">
      <IconSVG />
    </div>
    <div class="icon-color">
      <IconColorSVG />
    </div>
  </a>
  </div>
  
  
  <div class="nav-links">
    {links.map((link) => (
      <a href={link.href}>{link.text}</a>
    ))}
  </div>
  <span class="spacer" />
  <details class="mobile-menu">
    <summary aria-label="Toggle navigation menu">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </summary>
    <div class="mobile-menu-links">
      {links.map((link) => (
        <a href={link.href}>{link.text}</a>
      ))}
    </div>
  </details>
  <button class="theme-toggle" type="button" aria-label="Switch to light mode" hidden>
    <svg class="theme-sun" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
      <circle cx="12" cy="12" r="4" />
      <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42" />
    </svg>
    <svg class="theme-moon" xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <path d="M20.9 13.1A9 9 0 0 1 10.9 3.1a9 9 0 1 0 10 10Z" />
    </svg>
  </button>
</nav>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(".mobile-menu");

  if (menu) {
    menu.querySelectorAll("a").forEach((link) => {
      link.addEventListener("click", () => {
        menu.open = false;
      });
    });

    document.addEventListener("click", (event) => {
      if (menu.open && event.target instanceof Node && !menu.contains(event.target)) {
        menu.open = false;
      }
    });
  }
</script>
